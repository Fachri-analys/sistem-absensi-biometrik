# Salin ke .env dan isi dengan nilai asli. JANGAN PERNAH commit file .env
# ke repository (aturan #12 — lihat docs/06-SECURITY-SPEC.md).

NODE_ENV=development
LOG_LEVEL=info

# ---- Kredensial level docker-compose (dipakai HANYA saat menjalankan via
# docker-compose.yml — compose menyusun DATABASE_URL/REDIS_URL di bawah
# secara otomatis dari dua nilai ini, jadi cukup isi sekali di sini). ----
POSTGRES_PASSWORD="ganti-dengan-password-kuat"
REDIS_PASSWORD="ganti-dengan-password-kuat"

# ---- Dipakai langsung kalau menjalankan `npm run dev`/`npm run worker` di
# luar Docker (development lokal) — kalau via docker-compose, dua baris ini
# DIABAIKAN dan ditimpa otomatis oleh compose (lihat docker-compose.yml). ----
DATABASE_URL="postgresql://absensi:ganti-dengan-password-kuat@localhost:5432/absensi_biometrik"
REDIS_URL="redis://:ganti-dengan-password-kuat@localhost:6379"

# Session/JWT signing key — minimal 32 karakter acak, generate dengan:
# openssl rand -base64 48
SESSION_SECRET="ganti-dengan-nilai-acak-minimal-32-karakter"

# Salt untuk hashing API key kamera (HMAC) — generate dengan cara sama seperti di atas
CAMERA_API_KEY_SALT="ganti-dengan-nilai-acak-minimal-32-karakter"

# Object Storage (S3-compatible) — lihat docs/15-INFRASTRUCTURE-SPEC.md
OBJECT_STORAGE_ENDPOINT="https://s3.example.com"
OBJECT_STORAGE_REGION="auto"
OBJECT_STORAGE_ACCESS_KEY="ganti-ini"
OBJECT_STORAGE_SECRET_KEY="ganti-ini"
OBJECT_STORAGE_BUCKET_PHOTOS="absensi-student-photos"
OBJECT_STORAGE_BUCKET_REPORTS="absensi-reports"
OBJECT_STORAGE_BUCKET_ENROLLMENT_TEMP="absensi-enrollment-temp"

# Default ambang skor kecocokan wajah (ArcFace raw cosine similarity standard ~0.40)
FACE_MATCH_THRESHOLD_DEFAULT="0.40"

# face-service (Python internal — lihat face-service/README.md). Kalau
# dijalankan via docker-compose dan face-service ada di server TERPISAH,
# ganti host ke alamat/domain server itu, bukan localhost.
FACE_SERVICE_URL="http://localhost:8000"
# HARUS SAMA PERSIS dengan INTERNAL_SERVICE_KEY di face-service/.env
FACE_SERVICE_API_KEY="ganti-dengan-nilai-acak-minimal-32-karakter-sama-dengan-face-service"

# Multi-frame check-in. NEXT_PUBLIC_CHECKIN_FRAME_COUNT dibaca oleh browser
# dan server; CHECKIN_MIN_CONSISTENT_FRAMES adalah quorum identity+liveness.
# Jangan ubah salah satu tanpa menyesuaikan pasangan konfigurasi deployment.
NEXT_PUBLIC_CHECKIN_FRAME_COUNT="5"
CHECKIN_MIN_CONSISTENT_FRAMES="3"
NEXT_PUBLIC_CHECKIN_FRAME_INTERVAL_MS="150"

