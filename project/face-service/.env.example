# Salin ke .env. JANGAN commit .env ke repository.

# Shared secret dengan Next.js APP — HARUS sama persis dengan
# FACE_SERVICE_API_KEY di .env milik project Next.js. Generate dengan:
# openssl rand -base64 48
INTERNAL_SERVICE_KEY=

# Kunci AES-256 untuk enkripsi embedding, 32 byte dalam base64. Generate dengan:
# python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
# SIMPAN KUNCI INI DENGAN AMAN — kalau hilang, seluruh template biometrik
# tersimpan tidak bisa didekripsi lagi (semua siswa harus enrolment ulang).
EMBEDDING_ENCRYPTION_KEY=

# Lihat models/README.md untuk cara mendapatkan file ini.
LIVENESS_MODEL_PATH=./models/minifasnet.onnx
LIVENESS_INPUT_SIZE=80
# Kontrak default upstream 2.7_80x80_MiniFASNetV2.
LIVENESS_INPUT_COLOR_ORDER=BGR
LIVENESS_CROP_SCALE=2.7
LIVENESS_EXPECTED_CLASS_COUNT=3
LIVENESS_LIVE_CLASS_INDEX=1
LIVENESS_THRESHOLD=0.5

# Threshold kecocokan raw cosine similarity (ArcFace standard ~0.40)
# Dapat disesuaikan berdasarkan hasil script evaluasi dataset
MATCH_THRESHOLD=0.40
MATCH_THRESHOLD_DEFAULT=0.40
