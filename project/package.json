    "@types/react": "^18.3.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/pdfkit": "^0.13.4",
    "vitest": "^2.0.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.0",
    "@testcontainers/postgresql": "^10.13.0",
    "@testcontainers/redis": "^10.13.0",
    "testcontainers": "^10.13.0",
